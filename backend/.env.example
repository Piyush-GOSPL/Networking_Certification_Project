# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=networkprep_jwt_secret_key_2026_change_me_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database Configuration (Neon Postgres / Vercel Postgres)
# Any of these variables will automatically connect to Neon Postgres:
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-xxx-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-xxx.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob Storage Configuration (for question image uploads)
BLOB_STORE_ID=store_xxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxx
